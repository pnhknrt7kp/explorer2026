node_modules/
.DS_Store

# Local-only documents. This repository is PUBLIC, so the only PDF that may ever
# be committed is the released edition at assets/document.pdf. Every other PDF in
# assets/ is ignored by default — drafts, proofs, working copies — whatever it
# happens to be named. Safer than remembering a naming convention.
assets/*.pdf
!assets/document.pdf

# The older convention, kept because it also covers PDFs outside assets/.
*.local.pdf

# The Cloudflare Pages project name for draft deploys. The hostname it produces
# is what keeps an ungated draft obscure, so it stays out of this public repo.
.deploy-project
